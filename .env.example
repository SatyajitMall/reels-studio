# Optional: ElevenLabs Scribe transcripts (scripts/transcribe_reel.sh --scribe). The default is local Whisper, no key.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: stock B-roll search
PEXELS_API_KEY=

# AI video generation (Veo 3.1 via Gemini API): Google AI Studio key with billing on. Budget: studio/ai-budget.json
GEMINI_API_KEY=

# AI video generation, default provider (OpenRouter -> Veo 3.1 Lite, no audio). Caps: studio/ai-budget.json
OPENROUTER_API_KEY=
