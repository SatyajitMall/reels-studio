# Optional: ElevenLabs Scribe transcripts (scripts/transcribe_reel.sh --scribe). The default is local Whisper, no key.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: stock B-roll search
PEXELS_API_KEY=

# Unused since v0.10.0: gen_video.py's Gemini API route was removed (its Veo preview models shut down 2026-10-22).
GEMINI_API_KEY=

# AI video generation (OpenRouter -> Veo 3.1 Lite or Gemini Omni 1.2 Flash, no audio). Caps: studio/ai-budget.json
OPENROUTER_API_KEY=
