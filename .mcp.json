{
  "mcpServers": {
    "premiere-pro": {
      "command": "premiere-pro-mcp",
      "env": {
        "PREMIERE_MCP_TOOLSET": "full",
        "PREMIERE_MCP_TELEMETRY": "0",
        "PREMIERE_TEMP_DIR": "/tmp/premiere-mcp-bridge"
      }
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    }
  }
}
